.settings-container {
  padding: 20px;
  padding-top: 0;
}

.settings-group {
  background: white;
  border-radius: 12px;
  padding: 15px;
  margin-bottom: 20px;
}

.settings-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 15px;
  color: #333;
}

.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #eee;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item text {
  font-size: 14px;
  color: #666;
}

.picker-text {
  color: #333;
  padding: 5px 10px;
  background: #f5f5f5;
  border-radius: 4px;
}

.button-group {
  display: flex;
  justify-content: space-between;
  margin-top: 30px;
}

.reset-btn, .save-btn {
  flex: 1;
  margin: 0 10px;
  padding: 12px 0;
  border-radius: 24px;
}

.reset-btn {
  background: #f5f5f5;
  color: #666;
}

.save-btn {
  background: #4CAF50;
  color: white;
} 
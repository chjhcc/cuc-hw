/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.bg-image {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  z-index: 0;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
  position: relative;
  z-index: 1;
}

.title {
  font-size: 36px;
  font-weight: bold;
  color: #fff;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
  margin-bottom: 40px;
}

.menu {
  width: 80%;
  max-width: 300px;
  position: relative;
  z-index: 2;
}

.menu-btn {
  margin: 10px 0;
  background: #4CAF50;
  color: white;
  border-radius: 24px;
  font-size: 16px;
  opacity: 0.9;
  backdrop-filter: blur(5px);
}

.menu-btn.button-hover {
  opacity: 0.8;
}

.result-container {
  padding: 40px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.winner-info {
  text-align: center;
  margin-bottom: 40px;
}

.winner-avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  margin: 0 auto 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24px;
}

.winner-text {
  font-size: 24px;
  font-weight: bold;
  color: #FFD700;
}

.winner-score {
  font-size: 18px;
  color: #666;
  margin-top: 10px;
}

.other-players {
  width: 100%;
  margin-bottom: 40px;
}

.player-rank {
  display: flex;
  justify-content: space-between;
  padding: 10px;
  border-bottom: 1px solid #eee;
}

.restart-btn {
  background: #4CAF50;
  color: white;
  padding: 12px 40px;
  border-radius: 24px;
} 
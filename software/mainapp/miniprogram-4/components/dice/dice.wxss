.dice-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 10px;
}

.dice {
  width: 60px;
  height: 60px;
  position: relative;
  transition: transform 0.1s;
}

.dice.shake {
  animation: shake 0.5s ease-in-out;
}

@keyframes shake {
  0% { transform: translate(0, 0) rotate(0); }
  25% { transform: translate(-5px, -5px) rotate(-5deg); }
  50% { transform: translate(5px, 5px) rotate(5deg); }
  75% { transform: translate(-5px, 5px) rotate(-5deg); }
  100% { transform: translate(0, 0) rotate(0); }
}

.dice-face {
  position: absolute;
  width: 100%;
  height: 100%;
  background: white;
  border: 2px solid #333;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: bold;
  box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}

.dice-hint {
  font-size: 12px;
  color: #666;
  margin-top: 20rpx;
}

/* 骰子点数样式 */
.dice-dots {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  height: 100%;
  padding: 8px;
}

.dot {
  width: 8px;
  height: 8px;
  background: #333;
  border-radius: 50%;
  margin: auto;
}

/* 禁用状态 */
.dice-container.disabled {
  opacity: 0.5;
  pointer-events: none;
  cursor: not-allowed;
}

.dice {
  width: 60px;
  height: 60px;
  position: relative;
  transition: transform 0.1s;
} 
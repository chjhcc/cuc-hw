.board {
  width: 610rpx !important;
  height: 610rpx !important;
  position: relative;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 0 auto;
}

.board-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 4rpx solid #333;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 1;
}

.square {
  position: absolute;
  box-sizing: border-box;
  border: 2rpx solid #333;
  background-color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 8rpx;
  transition: all 0.3s ease;
  margin: 0;
  width: calc(610rpx / 8) !important;
  height: calc(610rpx / 8) !important;
  z-index: 0;
}

.square-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  overflow: hidden;
}

.square-name {
  font-size: 18.5rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
  color: #333;
  white-space: nowrap;
  text-overflow: ellipsis;
  width: 100%;
}

.square-price {
  font-size: 15.5rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.square.active {
  transform: scale(1.05);
  box-shadow: 0 0 10rpx rgba(0,0,0,0.2);
  z-index: 1;
}

.square.start {
  background-color: #4CAF50;
}

.square.start .square-name {
  color: #fff;
  font-size: 24rpx;
}

.square.chance {
  background-color: #FFC107;
}

.square.chance .square-name {
  color: #333;
}

.square.property {
  background-color: #fff;
}

/* 玩家棋子样式 */
.player-token {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
  transition: all 0.3s ease;
}

.score-log {
  width: 120%;
  max-width: 700rpx;
  margin: 60rpx auto;
  background-color: #fff;
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  padding: 20rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
  height: 400rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.log-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #eee;
  flex-shrink: 0;
}

.log-header {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
  background-color: #f8f8f8;
  border-bottom: 2rpx solid #eee;
  flex-shrink: 0;
  padding-right: 10rpx;
}

.log-header text {
}

.log-header .log-time {
  min-width: 120rpx;
}

.log-header .log-player {
  min-width: 120rpx;
  text-align: center;
}

.log-header .log-change {
  min-width: 80rpx;
  text-align: right;
}

.log-header .log-desc {
  flex: 1;
  padding-left: 20rpx;
}

.log-content {
  flex: 1;
  overflow-y: auto;
  padding: 0;
  -webkit-overflow-scrolling: touch;
  height: 300rpx;
  margin-right: -10rpx;
  padding-right: 10rpx;
}

.log-item {
  display: flex;
  align-items: center;
  padding: 15rpx 10rpx;
  font-size: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  line-height: 1.5;
  transition: background-color 0.3s;
  cursor: pointer;
}

.log-item:hover,
.log-item:active {
  background-color: #f9f9f9;
}

.log-time {
  color: #666;
  font-size: 22rpx;
  min-width: 120rpx;
  padding-left: 10rpx;
}

.log-player {
  color: #666;
  min-width: 120rpx;
  text-align: center;
}

.log-change {
  font-weight: bold;
  min-width: 80rpx;
  text-align: right;
  padding-right: 10rpx;
}

.log-item.increase .log-change {
  color: #4CAF50;
}

.log-item.decrease .log-change {
  color: #F44336;
}

.log-desc {
  color: #666;
  flex: 1;
  padding: 0 20rpx;
}

.log-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 24rpx;
  width: 100%;
  background-color: #f9f9f9;
}

/* 美化滚动条 */
.log-content::-webkit-scrollbar {
  width: 6rpx;
  background-color: transparent;
  display: block;
}

.log-content::-webkit-scrollbar-thumb {
  background-color: #ccc;
  border-radius: 3rpx;
  transition: background-color 0.3s;
}

.log-content::-webkit-scrollbar-thumb:hover {
  background-color: #bbb;
}

.log-content::-webkit-scrollbar-track {
  background-color: #f5f5f5;
  border-radius: 3rpx;
  margin: 2rpx 0;
} 